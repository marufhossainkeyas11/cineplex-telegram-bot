# Telegram Bot Token from @BotFather (Required)
BOT_TOKEN=

# Secret strings for securing webhook & cron endpoints (Required in production)
WEBHOOK_SECRET=
CRON_SECRET=

# Optional: Render automatically sets RENDER_EXTERNAL_URL (e.g. https://your-bot.onrender.com).
# Leave empty locally to run in Long Polling mode.
PUBLIC_WEBHOOK_URL=

# Persistent Database URL (Recommended for Render Free Tier: free Postgres from neon.tech or supabase.com)
# If omitted, falls back to local ./data/store.json (note: Render Free disk resets on restart)
DATABASE_URL=

# Public branding shown to users (internal API domain is never exposed)
PUBLIC_BRAND_NAME=STAR Cineplex
PUBLIC_SITE_URL=https://cineplexbd.com

# Internal Catalog API settings (hidden from end users)
API_BASE_URL=https://api.kichole.com/catalog/api
ORG_ID=0ab00001-0000-0000-0000-000000000001

# Optional: In-process periodic check interval in minutes (set 0 to rely solely on external cron /cron/check)
AUTO_CHECK_INTERVAL_MINUTES=0

# Server Port (Render injects PORT automatically)
PORT=3000
